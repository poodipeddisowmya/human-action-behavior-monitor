# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/

# Secrets and local settings (copy .env.example to .env)
.env

# Runtime output
/logs/
/runs/
*.db
*.sqlite3

# Build outputs and packaged zips (rebuild with scripts/package_for_kaggle.py)
/dist/
/backups/

# Frontend: dependencies only. ui/dist (the built dashboard) IS tracked so the
# app runs without Node installed.
ui/node_modules/
ui/.vite/
ui/tsconfig.tsbuildinfo

# Raw footage, kept out of the repo (large; re-download from SOURCES.md)
data/datasets/*
!data/datasets/.gitkeep
data/candidates/
data/downloads/**/*.mp4

# Personal phone recordings and client-supplied footage stay local
data/samples/WhatsApp_*
data/samples/client_sample_video.mp4

# Office documents (business reports, not source)
*.docx

# IDE / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# TensorRT engines are built per device (scripts/build_trt_engines.py)
models/*.engine
models/*.onnx

# Third-party test clips for the new activities (Mixkit / Wikimedia licences
# do not allow re-sharing the raw files in a public repo): kept local only.
data/new-activities/

# Proof images of people from the events log (src/storage/evidence.py):
# personal data, never committed.
data/evidence/

# Enrolled faces (src/identity/): biometric data, never committed.
data/faces/
data/samples/new-*
# Indian office set (Pexels): fetched by scripts/fetch_new_activity_clips.py.
data/samples/office-*
!data/samples/office-people.mp4
