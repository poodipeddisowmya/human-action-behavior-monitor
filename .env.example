# Copy to .env and edit values.
API_HOST=0.0.0.0
API_PORT=8000
UI_ORIGIN=http://localhost:5173

DATABASE_URL=sqlite+aiosqlite:///./logs/monitor.db

# Required to open the dashboard / call the API when set. Leave empty on a
# localhost-only machine; ALWAYS set it on a server others can reach.
ACCESS_TOKEN=

# Video sent to browsers (lower these over a slow link)
STREAM_FPS=20
STREAM_MAX_WIDTH=1280

# Pipeline
DEVICE=auto        # auto | cuda | cpu   (auto = GPU when one works)
TARGET_FPS=15      # Frames per second the pipeline aims for
CONFIDENCE_THRESHOLD=0.5

# Proof images for logged activities (2-3 shots of the person per event,
# under data/evidence/, shown in the dashboard's events table)
EVIDENCE=1
EVIDENCE_RETENTION_DAYS=30   # 0 = keep forever
# Activities recognised from a text description (making tea, taking tablets;
# GPU only): config/model_config.yaml, open_vocab:
OPEN_VOCAB=1
# Face recognition of enrolled people (docs/FACE_RECOGNITION.md)
FACE_ID=1
# Activities trained on your own clips (docs/TRAINING.md), when a model is
# installed in models/custom_activities/
CUSTOM_ACTIVITIES=1
# What the monitor plays when started without --source (e.g. by the service
# from scripts/install_service.sh): a CCTV camera's name, a camera index, or a
# video file. Empty = the first bundled demo clip.
# SOURCE=Reception
# On a CPU (no NVIDIA GPU), setup compiles the models for this machine
# (scripts/optimise_for_device.py). pytorch = ignore them.
# CPU_RUNTIME=auto
# CCTV / IP cameras, one line each: CAMERA_<NAME>=<RTSP or HTTP address>.
# They appear by name in the Source menu ("Reception", "Pantry"); start on
# one with --source Reception. Use the camera's sub-stream (720p or D1):
# the models work at 640 px, and a 4K main stream only costs decoding.
# The address and password stay on this machine (docs/CCTV.md).
# CAMERA_RECEPTION=rtsp://viewer:password@192.168.1.64:554/Streaming/Channels/102
# CAMERA_PANTRY=rtsp://viewer:password@192.168.1.65:554/cam/realmonitor?channel=1&subtype=1
# List the server's own USB cameras in the Source menu. Default: on with a
# desktop, off on a headless server. 0 for a recorded-clips-only demo.
# PROBE_CAMERAS=0
