# Copy to .env and edit values.
API_HOST=0.0.0.0
API_PORT=8000
UI_ORIGIN=http://localhost:5173

DATABASE_URL=sqlite+aiosqlite:///./logs/monitor.db

# Required to open the dashboard / call the API when set. Leave empty on a
# localhost-only machine; ALWAYS set it on a server others can reach.
ACCESS_TOKEN=

# Video sent to browsers (lower these over a slow link)
STREAM_FPS=20
STREAM_MAX_WIDTH=1280

# Pipeline
DEVICE=auto        # auto | cuda | cpu   (auto = GPU when one works)
TARGET_FPS=15      # Frames per second the pipeline aims for
CONFIDENCE_THRESHOLD=0.5

# Proof images for logged activities (2-3 shots of the person per event,
# under data/evidence/, shown in the dashboard's events table)
EVIDENCE=1
EVIDENCE_RETENTION_DAYS=30   # 0 = keep forever
# Activities recognised from a text description (making tea, taking tablets;
# GPU only): config/model_config.yaml, open_vocab:
OPEN_VOCAB=1
# Face recognition of enrolled people (docs/FACE_RECOGNITION.md)
FACE_ID=1
# List the server's own USB cameras in the Source menu. Default: on with a
# desktop, off on a headless server. 0 for a recorded-clips-only demo.
# PROBE_CAMERAS=0
